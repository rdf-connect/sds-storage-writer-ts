@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

rdfcp:IngestSDS rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/index.js>;
  rdfs:label "SDS Storage Writer";
  rdfs:comment "Processor that can ingest a SDS stream into a given storage system. It uses sds:Bucket to describe the used fragmentation strategy (see rdfc:Bucketize).";
  rdfc:class "IngestSDS";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:IngestSDS;
  sh:property [
    sh:class rdfc:Reader;
    sh:path rdfcp:dataInput;
    sh:codeIdentifier "data";
    sh:name "Data channel";
    sh:description "The reader IRI that provides the data stream to be ingested.";
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:class rdfc:Reader;
    sh:path rdfcp:metadataInput;
    sh:codeIdentifier "metadata";
    sh:name "Metadata channel";
    sh:description "The reader IRI that provides the metadata stream to be ingested.";
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:node rdfcp:IngestSDSDatabaseConfigShape;
    sh:path rdfcp:database;
    sh:minCount 1;
    sh:maxCount 1;
    sh:codeIdentifier "database";
    sh:name "Database";
    sh:description "The configuration of the database to ingest the data into.";
  ].

rdfcp:IngestSDSDatabaseConfigShape a sh:NodeShape;
  sh:property [
    sh:datatype xsd:string;
    sh:path rdfcp:metadata;
    sh:minCount 1;
    sh:maxCount 1;
    sh:defaultValue "meta";
    sh:codeIdentifier "metadata";
    sh:name "Metadata collection";
    sh:description "Name of the metadata collection";
  ], [
    sh:datatype xsd:string;
    sh:path rdfcp:data;
    sh:minCount 1;
    sh:maxCount 1;
    sh:codeIdentifier "data";
    sh:name "Data collection";
    sh:description "Name of the data collection";
  ], [
    sh:datatype xsd:string;
    sh:path rdfcp:index;
    sh:minCount 1;
    sh:maxCount 1;
    sh:codeIdentifier "index";
    sh:name "Index collection";
    sh:description "Name of the index collection";
  ], [
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:path rdfcp:url;
    sh:maxCount 1;
    sh:codeIdentifier "url";
    sh:name "Database URL";
    sh:description "Collection url used to connect to the mongo database";
  ].

